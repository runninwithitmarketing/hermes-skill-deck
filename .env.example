# API keys for the Terminal Mode AI agent.
# Only the provider(s) you actually use need a key. Copy this file to `.env`
# (the backend loads it automatically if python-dotenv is installed) or export
# the variables in your shell before starting the server.

# DeepSeek (default model) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=

# Anthropic / Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
